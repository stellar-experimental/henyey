# History-archive output artifacts (defense in depth).
# These appear when a publish command writes archive output relative to CWD.
# The archive format uses hex-sharded directories (e.g., bucket/93/6f/3d/,
# history/00/00/00/). Patterns target the sharded structure to avoid
# accidentally ignoring legitimate paths like crates/bucket/ (Rust crate).

# Repo-root level (CWD = repo root)
/.well-known/stellar-history.json
/bucket/[0-9a-f][0-9a-f]/
/history/[0-9a-f][0-9a-f]/
/ledger/[0-9a-f][0-9a-f]/
/results/[0-9a-f][0-9a-f]/
/scp/[0-9a-f][0-9a-f]/
/transactions/[0-9a-f][0-9a-f]/

# Crate-level (CWD = crates/<name>/)
crates/*/.well-known/stellar-history.json
crates/*/bucket/[0-9a-f][0-9a-f]/
crates/*/history/[0-9a-f][0-9a-f]/
crates/*/ledger/[0-9a-f][0-9a-f]/
crates/*/results/[0-9a-f][0-9a-f]/
crates/*/scp/[0-9a-f][0-9a-f]/
crates/*/transactions/[0-9a-f][0-9a-f]/

# Monitor/evaluator scratch state (#3201, defense in depth).
# These leak into the tracked repo-root metrics/ dir when monitor-tick or
# eval-alarms.py runs with a relative --state-dir from repo-root cwd, dirtying
# the working tree and hard-blocking the deploy gate. Anchor with a leading '/'
# so ONLY the repo-root metrics/ dir is matched — the tracked dashboards
# (metrics/henyey-dashboard.json, ...) and any crates/*/metrics are unaffected.
/metrics/current.prom
/metrics/prev.prom
/metrics/gauge_persistence
/metrics/scrape_identity
/metrics/counter_streak_snapshot
/metrics/recovery_family_streak_snapshot
/metrics/ratio_snapshot
/metrics/counter_dynamic_snapshot
/metrics/anomaly_cooldown.json
/metrics/archive/
scripts/lib/__pycache__/
.alarm-regression-filing.lock
.alarm-regression-filed.json
.monitor-tick-filed.json
.monitor-tick-filing.lock
scripts/ci/__pycache__/
.copilot-scratch/
stellar-core-pc/
